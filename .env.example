# Copy this file to api/.env and fill in the values.
# Never commit a real key.

# Google AI Studio key. Server-side only.
GEMINI_API_KEY=

# Extraction backend: leave empty to use Gemini when a key is set, and the offline
# demo dictionary when it is not. Set to "mock" or "gemini" to force one.
SKILLSYNC_EXTRACTOR=

# Model requests allowed per client address per hour (a CV counts 1, each posting 1).
# 0 turns the limit off.
SKILLSYNC_RATE_LIMIT=20

# Model used for extraction and planning.
GEMINI_MODEL=gemini-3.6-flash

# Optional: models tried in order, comma-separated, when the main one stays busy (Google
# answers 503) or its daily quota is used up (429). Each model has its own free quota.
GEMINI_FALLBACK_MODEL=

# Optional: a GoatCounter site code (the name before .goatcounter.com) to count visits
# anonymously. Empty turns counting off.
GOATCOUNTER_CODE=

# Optional: a GoatCounter API key with read access ("Read statistics"). The landing then
# shows the dashboard's own count; without it, the public counter is used. Keep it secret.
GOATCOUNTER_API_KEY=
